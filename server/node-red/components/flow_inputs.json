    {
        "id": "24547ae03b64e631",
        "type": "comment",
        "z": "73fec5176ff2b148",
        "name": "Download log files",
        "info": "HTTP endpoints: GET /download/log_tx.csv and GET /download/log_alarms.csv\nFlow: http in (/download/:filename) -> 'validate filename' (whitelist; builds\nmsg.filename from the LORALARM_LOG_TX / LORALARM_LOG_ALARMS env vars; unknown names -> 404 straight to http\nresponse) -> file in (reads msg.filename) -> 'set download headers' (200 with\ntext/csv and Content-Disposition attachment, or 404 when the file is missing)\n-> http response.\nThe monthly job above deletes the same files, so download them before month end.",
        "x": 200,
        "y": 760,
        "wires": []
    },
    {
        "id": "7e269376afbf2b7a",
        "type": "http in",
        "z": "73fec5176ff2b148",
        "name": "GET /download/:filename",
        "url": "/download/:filename",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 180,
        "y": 800,
        "wires": [
            [
                "a7c1e8d94b0f3215"
            ]
        ]
    },
    {
        "id": "a7c1e8d94b0f3215",
        "type": "function",
        "z": "73fec5176ff2b148",
        "name": "validate filename",
        "func": "var files = {\"log_tx.csv\": env.get(\"LORALARM_LOG_TX\"), \"log_alarms.csv\": env.get(\"LORALARM_LOG_ALARMS\")};\nvar allowed = Object.keys(files);\nvar f = msg.req.params.filename;\nif (!Object.prototype.hasOwnProperty.call(files, f) || !files[f]) {\n    msg.statusCode = 404;\n    msg.headers = {\"Content-Type\": \"text/plain\"};\n    msg.payload = \"Unknown log file. Available: \" + allowed.join(\", \");\n    return [null, msg];\n}\nmsg.filename = files[f];\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 800,
        "wires": [
            [
                "6dc068df9cea7bf7"
            ],
            [
                "32cb39d380699191"
            ]
        ]
    },
    {
        "id": "6dc068df9cea7bf7",
        "type": "file in",
        "z": "73fec5176ff2b148",
        "name": "read log file",
        "filename": "filename",
        "filenameType": "msg",
        "format": "utf8",
        "chunk": false,
        "sendError": true,
        "encoding": "none",
        "allProps": false,
        "x": 600,
        "y": 800,
        "wires": [
            [
                "0989b5d3112523d9"
            ]
        ]
    },
    {
        "id": "0989b5d3112523d9",
        "type": "function",
        "z": "73fec5176ff2b148",
        "name": "set download headers",
        "func": "if (msg.error) {\n    msg.statusCode = 404;\n    msg.headers = {\"Content-Type\": \"text/plain\"};\n    msg.payload = \"Log file not found: \" + (msg.error.message || \"\");\n} else {\n    var name = msg.req.params.filename;\n    msg.headers = {\n        \"Content-Disposition\": \"attachment; filename=\\\"\" + name + \"\\\"\",\n        \"Content-Type\": \"text/csv; charset=utf-8\"\n    };\n    msg.statusCode = 200;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 800,
        "wires": [
            [
                "32cb39d380699191"
            ]
        ]
    },
