    {
        "id": "44631d2d0afa6e66",
        "type": "comment",
        "z": "73fec5176ff2b148",
        "name": "Resend 3-axis sensor config on sensor join/restart",
        "info": "Saves threshold/frequency/duration in persistent global context (localfilesystem store).\nOn sensor rejoin (e.g. battery loss), resends last known settings as downlinks.",
        "x": 230,
        "y": 440,
        "wires": []
    },
    {
        "id": "f4ac95b31f4e94da",
        "type": "function",
        "z": "73fec5176ff2b148",
        "name": "init sensorSettings defaults",
        "func": "var sensorConfig = global.get(\"sensorConfig\") || {};\nvar settings = global.get(\"sensorSettings\", \"default\") || {};\nvar changed = false;\nObject.keys(sensorConfig).forEach(function(name) {\n    if (!sensorConfig[name].hasSettings) return;\n    var eui = sensorConfig[name].devEui;\n    if (eui && !settings[eui]) {\n        settings[eui] = { interrupt_threshold: null, acc_frequency: null, interrupt_duration: null };\n        changed = true;\n    }\n});\nif (changed) global.set(\"sensorSettings\", settings, \"default\");\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 280,
        "wires": [
            []
        ]
    },
    {
        "id": "43225811916a12df",
        "type": "mqtt in",
        "z": "73fec5176ff2b148",
        "name": "join events",
        "topic": "application/+/device/+/event/join",
        "qos": "1",
        "datatype": "json",
        "broker": "6702f55c7ff28076",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 120,
        "y": 480,
        "wires": [
            [
                "d81ed8da1d62b5d8"
            ]
        ]
    },
    {
        "id": "d81ed8da1d62b5d8",
        "type": "function",
        "z": "73fec5176ff2b148",
        "name": "resend settings on join",
        "func": "var app = (global.get(\"application\") || {}).sublarm;\nif (!app || String(msg.topic).split(\"/\")[1] !== app) return null;\n\nvar devEui = msg.payload.deviceInfo && msg.payload.deviceInfo.devEui;\nif (!devEui) return null;\n\nvar settings = global.get(\"sensorSettings\", \"default\") || {};\nvar s = settings[devEui];\nif (!s) return null;\n\nvar msgs = [];\nif (s.interrupt_threshold) msgs.push({ payload: s.interrupt_threshold, fPort: \"5\", confirmed: \"false\", devEui: devEui });\nif (s.acc_frequency) msgs.push({ payload: s.acc_frequency, fPort: \"6\", confirmed: \"false\", devEui: devEui });\nif (s.interrupt_duration)  msgs.push({ payload: s.interrupt_duration,  fPort: \"7\", confirmed: \"false\", devEui: devEui });\n\nif (msgs.length === 0) return null;\nreturn [msgs];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 480,
        "wires": [
            [
                "e60b917cc5b4561d"
            ]
        ]
    },
