    {
        "id": "d81ed8da1d62b5d8",
        "type": "function",
        "z": "73fec5176ff2b148",
        "name": "resend settings on join",
        "func": "var devEui = msg.payload.deviceInfo && msg.payload.deviceInfo.devEui;\nif (!devEui) return null;\n\nvar settings = global.get(\"sensorSettings\", \"default\") || {};\nvar s = settings[devEui];\nif (!s) return null;\n\nvar msgs = [];\nif (s.interrupt_threshold) msgs.push({ payload: s.interrupt_threshold, fPort: \"5\", confirmed: \"false\", devEui: devEui });\nif (s.acc_frequency) msgs.push({ payload: s.acc_frequency, fPort: \"6\", confirmed: \"false\", devEui: devEui });\nif (s.interrupt_duration)  msgs.push({ payload: s.interrupt_duration,  fPort: \"7\", confirmed: \"false\", devEui: devEui });\n\nif (msgs.length === 0) return null;\nreturn [msgs];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 480,
        "wires": [
            [
                "e60b917cc5b4561d"
            ]
        ]
    },
