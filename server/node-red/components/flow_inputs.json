        "d": true,
        "name": "set download headers",
        "func": "if (msg.error) {\n    msg.statusCode = 404;\n    msg.headers = {\"Content-Type\": \"text/plain\"};\n    msg.payload = \"Log file not found: \" + msg.error.message;\n} else {\n    msg.headers = {\n        \"Content-Disposition\": \"attachment; filename=\\\"log_tx_sensor16.csv\\\"\",\n        \"Content-Type\": \"text/csv; charset=utf-8\"\n    };\n    msg.statusCode = 200;\n}\nreturn msg;",
