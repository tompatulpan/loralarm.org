{
  "defaults": {
    "kind": "sensor",
    "tilt_sense_g": 0.3,
    "watchdog_hours": 0.5,
    "ntfy_topic": "loralarm",
    "notify_title": "loralarm {name}",
    "notify_fire": {
      "temp": "{label} på {name}: {detail}",
      "battery_low": "{label} på {name}: {detail}",
      "battery_empty": "{label} på {name}: {detail}",
      "motion": "{label} på {name}",
      "circuit": "{label} på {name}: {detail}",
      "tilt": "{label} på {name}: {detail}",
      "stale": "{label} på {name}: {detail}"
    },
    "notify_clear": {
      "temp": "{label} kvitterad på {name}",
      "battery_low": "{label} kvitterad på {name}",
      "battery_empty": "{label} kvitterad på {name}",
      "motion": "{label} kvitterad på {name}",
      "circuit": "{label} kvitterad på {name}",
      "tilt": "{label} kvitterad på {name}",
      "stale": "{label} kvitterad på {name}"
    }
  },
  "devices": {
    "ac1f09fffe1003ae": {
      "name": "sensor3",
      "ntfy_topic": "sensor3",
      "pushover_user": "${LORALARM_PUSHOVER_USER}",
      "pushover_token": "${LORALARM_PUSHOVER_TOKEN}"
    },
    "ac1f09fffe12da63": {
      "name": "sensor16",
      "ntfy_topic": "sensor16",
      "pushover_user": "${LORALARM_PUSHOVER_USER}",
      "pushover_token": "${LORALARM_PUSHOVER_TOKEN}"
    }
  }
}
