{
  "defaults": {
    "kind": "sensor",
    "tilt_sense_g": 0.3,
    "watchdog_hours": 24,
    "motion_mode": "event",
    "motion_window_s": 30,
    "motion_min_detections": 1,
    "ntfy_topic": "loralarm",
    "notify_title": "loralarm {name}",
    "notify_fire": {
      "temp": "{label} på {name}: {detail}",
      "battery_low": "{label} på {name}: {detail}",
      "battery_empty": "{label} på {name}: {detail}",
      "motion": "{label} på {name}",
      "circuit": "{label} på {name}: {detail}",
      "tilt": "{label} på {name}: {detail}",
      "stale": "{label} på {name}: {detail}"
    },
    "notify_clear": {
      "temp": "{label} kvitterad på {name}",
      "battery_low": "{label} kvitterad på {name}",
      "battery_empty": "{label} kvitterad på {name}",
      "motion": "{label} kvitterad på {name}",
      "circuit": "{label} kvitterad på {name}",
      "tilt": "{label} kvitterad på {name}",
      "stale": "Kommunikationen med {name} är återupptagen"
    }
  },
  "devices": {
    "ac1f09fffe1003ae": {
      "name": "sensor3",
      "family": "RAK4631",
      "application_id": "${LORALARM_CS_APP_LARM}",
      "ntfy_topic": "sensor3",
      "watchdog_hours": 0.5,
      "threshold": 8,
      "frequency": 10,
      "duration": 1,
      "pushover_user": "${LORALARM_PUSHOVER_USER}",
      "pushover_token": "${LORALARM_PUSHOVER_TOKEN}"
    },
    "ac1f09fffe12da63": {
      "name": "sensor16",
      "family": "RAK3172",
      "application_id": "${LORALARM_CS_APP_SUBLARM}",
      "ntfy_topic": "sensor16",
      "watchdog_hours": 0.5,
      "pushover_user": "${LORALARM_PUSHOVER_USER}",
      "pushover_token": "${LORALARM_PUSHOVER_TOKEN}"
    },
    "a84041a5d7598dd0": {
      "name": "Door1",
      "family": "Dragino Switch LDS02",
      "ntfy_topic": "door1",
      "watchdog_hours": 12,
      "pushover_user": "${LORALARM_PUSHOVER_USER}",
      "pushover_token": "${LORALARM_PUSHOVER_TOKEN}"
    },
    "a84041e3d189503d": {
      "name": "Door2",
      "family": "Dragino Switch LDS02",
      "ntfy_topic": "door2",
      "watchdog_hours": 12,
      "pushover_user": "${LORALARM_PUSHOVER_USER}",
      "pushover_token": "${LORALARM_PUSHOVER_TOKEN}"
    }
  }
}
