# Python build / runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging
build/
dist/
*.egg-info/

# Local secrets / runtime data — never commit these.
# NB: gitignore has no inline comments; keep comments on their own lines.
notes.txt
# the real config (devices.example.json is the tracked template)
devices.json
.env
# SQLite events log lives here at runtime
*.db
