{
  "name": "Dragino Switch LDS02",
  "description": "Dragino LDS02 door switch (third-party codec, fPort 10): DOOR_OPEN_STATUS 1 = open / 0 = closed, sent on every change plus a heartbeat. No temperature, no downlink settings. Battery is 2 x AAA (~3.0 V fresh): limits are an assumption, tune per device.",
  "aliases": ["lds02"],
  "data_ports": [10],
  "fields": {
    "battery_voltage": {"from": "BAT_V", "unit": "V", "type": "number"},
    "door_open": {"from": "DOOR_OPEN_STATUS"}
  },
  "settings": [],
  "settings_kinds": [],
  "defaults": {
    "kind": "door",
    "batt_full_v": 3.0,
    "batt_warn_v": 2.5,
    "batt_empty_v": 2.2
  },
  "rules": [
    {
      "kind": "door",
      "label": "Dörrlarm",
      "field": "door_open",
      "when": "truthy",
      "fire": "dörren är öppen",
      "clear": "dörren är stängd",
      "device_kinds": ["door"],
      "notify_fire": "🚪 DÖRRLARM: {name} — {detail}",
      "notify_clear": "✔️ Dörr stängd: {name} — {detail}"
    }
  ]
}
