# /etc/loralarm/loralarm.env — read by systemd (EnvironmentFile), 640 root:loralarm.
# Every ${NAME} placeholder in devices.json must have its variable here.
# Fill these in by hand on the container; never commit the real values.

# --- channels -------------------------------------------------------------
LORALARM_PUSHOVER_USER=
LORALARM_PUSHOVER_TOKEN=
# ntfy is unauthenticated on the lora box (self-hosted); basic-auth token only
# if you enable one:
#LORALARM_NTFY_TOKEN=

# --- MQTT -----------------------------------------------------------------
# user for the lora box broker (password stays in /etc/loralarm/mqtt.pass)
LORALARM_MQTT_USER=tomas

# --- ChirpStack application ids (downlink targets) ------------------------
LORALARM_CS_APP_LARM=
LORALARM_CS_APP_SUBLARM=

# --- PWA web users (one token per user in devices.json "web_users") --------
# openssl rand -hex 16
LORALARM_TOKEN_ANNA=
LORALARM_TOKEN_BOSSE=

# --- PWA web push (later, with the HTTPS tunnel; empty until then) ---------
#LORALARM_VAPID_PRIVATE_KEY=
#LORALARM_VAPID_PUBLIC_KEY=
